# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#   cp .env.example .env
#
# Real environment variables take precedence over this file, so a platform's
# own injected vars (Render, Fly) always win over anything written here.

# --- graph database --------------------------------------------------------
# The shared team database (Supabase). Ask whoever set the project up for the
# string — it is a credential, so pass it through a password manager, never
# git or chat.
#
# Use the DIRECT connection on port 5432, or the SESSION pooler (also 5432).
# NOT the transaction pooler on 6543: graph writes use SAVEPOINTs inside
# multi-statement transactions, which is session-level behaviour.
# A `postgres://` scheme is fine — the app rewrites it for SQLAlchemy.
#
# LEAVE THIS BLANK to work against your own private local SQLite file instead
# (./artemis.db). That is the right choice for solo development: it costs
# nothing, isolates your experiments, and cannot disturb anyone else's data.
DATABASE_URL=

# Overrides DATABASE_URL when set. Handy for pointing at a scratch database
# without unsetting the team one. Leave blank unless you mean it.
ARTEMIS_DB_URL=

# --- keys ------------------------------------------------------------------
# Turns Alpha ON. Without it, node profiling and search strategy are inert
# no-ops and the relation classifier never runs. Costs real money per build.
ANTHROPIC_API_KEY=

# Web search. Serper is first in ARTEMIS_ROUTE_PERSON — cheapest, best recall.
# Both are optional; with neither, search falls back to DuckDuckGo and quality
# drops sharply. Both cost real money per build.
SERPER_API_KEY=
BRAVE_API_KEY=

# --- deployment only -------------------------------------------------------
# Gates the entire UI and API. Unset, a deployed instance is wide open and
# anyone who finds the URL can spend your search/Anthropic budget.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARTEMIS_ACCESS_TOKEN=
